.innerHTML = ''; // clear\r\n        \r\n        credentials.forEach(cred => {\r\n          const option = document.createElement('option');\r\n          option.value = cred.id;\r\n          option.text = cred.name || cred.workspaceId || cred.id;\r\n          select.appendChild(option);\r\n        });\r\n        \r\n        document.getElementById('auth-section').style.display = 'none';\r\n        document.getElementById('app-section').style.display = 'block';\r\n      } catch (err) {\r\n        document.getElementById('result').innerText = 'Error: ' + err.message;\r\n      }\r\n    }\r\n    \r\n    document.getElementById('connect-paragon').addEventListener('click', init);\r\n    \r\n    document.getElementById('message-form').addEventListener('submit', async (e) => {\r\n      e.preventDefault();\r\n      const accountId = document.getElementById('account-select').value;\r\n      const channel = document.getElementById('channel-input').value;\r\n      const message = document.getElementById('message-input').value;\r\n      \r\n      try {\r\n        const res = await fetch('/api/send-message', {\r\n          method: 'POST',\r\n          headers: { 'Content-Type': 'application/json' },\r\n          body: JSON.stringify({ accountId, channel, message })\r\n        });\r\n        \r\n        const data = await res.json();\r\n        document.getElementById('result').innerText = JSON.stringify(data, null, 2);\r\n      } catch (err) {\r\n        document.getElementById('result').innerText = 'Error: ' + err.message;\r\n      }\r\n    });\r\n  </script>\r\n\r\n\r\n\r\n","isTruncated":false},"callProviderMetadata":{"vertex":{"thoughtSignature":""}}},{"type":"step-start"},{"type":"tool-executeCommand","toolCallId":"754ipvZIUrDSgV6z","state":"output-available","input":{"command":"agent-browser click \"button[type='submit']\""},"output":{"output":"✓ Done\r\n","isTruncated":false},"callProviderMetadata":{"vertex":{"thoughtSignature":"AY89a1/9+BzF8QAx725IOTpY9ex3FF16FDgNPgS59s8K